{
  "name": "piastria-ang",
  "version": "1.4.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --no-hmr",
    "start:int": "ng serve --configuration=int --no-hmr",
    "start:int-ide": "ng serve --configuration=int-ide --no-hmr",
    "build": "ng build",
    "test": "ng test",
    "test:watch": "ng test --watch",
    "test:coverage": "ng test --coverage",
    "lint": "ng lint",
    "e2e": "playwright test --config=e2e/playwright.config.ts",
    "e2e:ui": "playwright test --config=e2e/playwright.config.ts --ui",
    "seed": "node -e \"require('fs').copyFileSync('server/db-original.json','server/db.json')\"",
    "server": "npx json-server@0.17 --watch server/db.json --routes server/routes.json",
    "server:data": "npm run seed && npm run server"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.1.0",
    "@angular/cdk": "^22.1.0",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/material": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-browser-dynamic": "^22.1.0",
    "@angular/router": "^22.1.0",
    "d3": "^7.9.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.6.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^22.1.0",
    "@angular-eslint/eslint-plugin": "^22.1.0",
    "@angular-eslint/eslint-plugin-template": "^22.1.0",
    "@angular-eslint/schematics": "^22.1.0",
    "@angular-eslint/template-parser": "^22.1.0",
    "@angular/build": "^22.1.0",
    "@angular/cli": "^22.1.0",
    "@angular/compiler-cli": "^22.1.0",
    "@angular/language-service": "^22.1.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.49.0",
    "@types/d3": "^7.4.0",
    "@types/node": "^22.12.0",
    "angular-eslint": "^22.1.0",
    "eslint": "^10.8.0",
    "jsdom": "^25.0.1",
    "ts-node": "~10.9.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.0.8"
  }
}
